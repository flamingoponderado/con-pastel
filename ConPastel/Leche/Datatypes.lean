import ConPastel.Leche.KernelJoint
import ConPastel.Leche.Blob

/-!
# Translation stage: the datatypes of the checker and the frontend

The checker (`ConPastel.Leche.Checker`) and the frontend
(`ConPastel.Leche.Frontend`) are independent modules (`cake_module`) over this
one, so that Lake builds them in parallel. Datatypes must be shared by every
module that passes their values to each other, so they are registered here,
in the base chain, in the order the translator would register them.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 200000
set_option linter.all false

namespace ConPastel.Leche

